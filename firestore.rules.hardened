rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId));
    }

    function securityMode(userId) {
      return userDoc(userId).data.securityMode == 'hardened';
    }

    function claimRole() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return claimRole() == 'admin';
    }

    function isCashierOrAdmin() {
      return claimRole() == 'admin' || claimRole() == 'cashier';
    }

    // Legacy: full owner access (current production behavior)
    function legacyOwnerWrite(userId) {
      return isOwner(userId) && !securityMode(userId);
    }

    // Hardened: catalog / CRM writes for cashier+admin; financial writes server-only
    function hardenedCatalogWrite(userId) {
      return isOwner(userId) && securityMode(userId) && isCashierOrAdmin();
    }

    function financialSubpath(sub) {
      return sub in [
        'orders', 'orderEdits', 'openBills', 'cashShifts', 'cashMovements',
        'vault', 'vaultMovements', 'counters', 'idempotency', 'cashShiftIdempotency',
        'orderReturns', 'orderReturnAudits', 'checks', 'payrollAccruals', 'payrollPayments',
        'employeeAdvances', 'advanceRepayments', 'supplierOpeningBalances', 'employeeBenefits',
        'employeeBenefitIdempotency', 'openBills'
      ];
    }

    function sensitiveExpenseCreate() {
      return request.resource.data.keys().hasAny([
        'payrollAccrualId', 'employeeAdvanceId', 'advanceRepaymentId', 'isAdvanceRepayment'
      ]);
    }

    function isBalanceOnlySupplierPatch() {
      return request.resource != null
        && resource != null
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['balance', 'balanceReconciledAtMs', 'updatedAt']);
    }

    function isAuditedSupplierBalanceCorrection() {
      return request.resource.data.keys().hasAll([
        'balance', 'balanceCorrectionAtMs', 'balanceCorrectionBy', 'balanceCorrectionReason'
      ]);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if legacyOwnerWrite(userId)
        || (isOwner(userId) && securityMode(userId) && isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['securityMode', 'updatedAt']));
      allow delete: if false;

      match /suppliers/{supplierId} {
        allow read: if isOwner(userId);
        allow write: if legacyOwnerWrite(userId);
        allow create, delete: if isOwner(userId) && securityMode(userId) && hardenedCatalogWrite(userId);
        allow update: if isOwner(userId) && securityMode(userId) && isAdmin() && isAuditedSupplierBalanceCorrection();
        allow update: if isOwner(userId) && securityMode(userId) && hardenedCatalogWrite(userId)
          && !isBalanceOnlySupplierPatch();
      }

      match /customers/{customerId} {
        allow read: if isOwner(userId);
        allow write: if legacyOwnerWrite(userId);
        allow create, update, delete: if isOwner(userId) && securityMode(userId) && hardenedCatalogWrite(userId);
      }

      match /{subCollection}/{docId} {
        allow read: if isOwner(userId);

        allow write: if legacyOwnerWrite(userId);

        allow create, update, delete: if isOwner(userId)
          && securityMode(userId)
          && !financialSubpath(subCollection)
          && hardenedCatalogWrite(userId);

        allow create: if isOwner(userId)
          && securityMode(userId)
          && subCollection == 'expenses'
          && isCashierOrAdmin()
          && !sensitiveExpenseCreate();
      }

      match /vault/{docId} {
        allow read: if isOwner(userId) && (!securityMode(userId) || isAdmin());
        allow write: if legacyOwnerWrite(userId);
        allow write: if false;
      }

      match /counters/{docId} {
        allow read: if isOwner(userId);
        allow write: if legacyOwnerWrite(userId);
        allow write: if false;
      }
    }
  }
}
