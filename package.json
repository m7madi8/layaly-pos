{
  "name": "cafe-pos",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^13.5.0",
    "firebase": "^10.7.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.263.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "prebuild": "node scripts/assert-production-env.js",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:rules": "firebase emulators:exec --only firestore --project layali-rules-test \"npx jest -c jest.rules.config.js --runInBand\"",
    "test:functions:unit": "npx jest -c jest.functions.config.js --runInBand tests/functions/orderEngine.unit.test.js tests/functions/idempotency.unit.test.js tests/functions/hookahPricing.unit.test.js tests/functions/cashShift.unit.test.js tests/functions/authz.unit.test.js tests/functions/callableActor.unit.test.js",
    "verify:staging-deploy-context": "node scripts/check-staging-deploy-context.js",
    "test:functions:integration": "firebase emulators:exec --only firestore --project layali-rules-test \"npx jest -c jest.functions.config.js --runInBand tests/functions/orderEngine.emulator.test.js\"",
    "test:functions:emulator": "npx jest -c jest.functions.config.js --runInBand tests/functions/orderEngine.emulator.test.js tests/functions/cashShift.emulator.test.js tests/functions/concurrency.emulator.test.js",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase-admin": "^12.7.0",
    "autoprefixer": "^10.4.23",
    "firebase-tools": "^13.29.1",
    "jest": "^27.5.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.1"
  }
}
