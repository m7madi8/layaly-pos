rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function memberDocPath(tenantId) {
      return /databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid);
    }

    function memberActive(tenantId) {
      return signedIn()
        && exists(memberDocPath(tenantId))
        && get(memberDocPath(tenantId)).data.active == true;
    }

    function memberRole(tenantId) {
      return get(memberDocPath(tenantId)).data.role;
    }

    function isTenantAdmin(tenantId) {
      return memberActive(tenantId) && memberRole(tenantId) == 'admin';
    }

    function isTenantCashier(tenantId) {
      return memberActive(tenantId) && memberRole(tenantId) == 'cashier';
    }

    function isTenantStaff(tenantId) {
      return memberActive(tenantId)
        && (memberRole(tenantId) == 'cashier' || memberRole(tenantId) == 'admin');
    }

    /** Legacy cafés: data at users/{authUid} before tenants/{tenantId} exists. */
    function legacyUnmigratedOwner(tenantId) {
      return signedIn()
        && request.auth.uid == tenantId
        && !exists(/databases/$(database)/documents/tenants/$(tenantId));
    }

    function canReadBusinessData(tenantId) {
      return legacyUnmigratedOwner(tenantId) || isTenantStaff(tenantId);
    }

    function canWriteBusinessData(tenantId) {
      return legacyUnmigratedOwner(tenantId) || isTenantStaff(tenantId);
    }

    function adminOnlyCollection(sub) {
      return sub in [
        'vault', 'vaultMovements', 'payrollAccruals', 'payrollPayments',
        'businessDayAdjustments', 'orderReturnAudits', 'businessDays'
      ];
    }

    function closeVaultMovementId(shiftId) {
      return 'from_cash_close_' + shiftId;
    }

    function closeCashDrawerMovementId(shiftId) {
      return 'shift_close_vault_' + shiftId;
    }

    function vaultMainPath(tenantId) {
      return /databases/$(database)/documents/users/$(tenantId)/vault/main;
    }

    function closeCashDrawerMovementPath(tenantId, shiftId) {
      return /databases/$(database)/documents/users/$(tenantId)/cashMovements/$(closeCashDrawerMovementId(shiftId));
    }

    function shiftDocPath(tenantId, shiftId) {
      return /databases/$(database)/documents/users/$(tenantId)/cashShifts/$(shiftId);
    }

    function shiftAfter(tenantId, shiftId) {
      return getAfter(shiftDocPath(tenantId, shiftId));
    }

    function vaultMovementAfterPath(tenantId, movementId) {
      return /databases/$(database)/documents/users/$(tenantId)/vaultMovements/$(movementId);
    }

    function shiftWasOpenForVault(tenantId, shiftId) {
      return exists(shiftDocPath(tenantId, shiftId))
        && get(shiftDocPath(tenantId, shiftId)).data.status == 'open';
    }

    function shiftAfterClosedForVault(tenantId, shiftId) {
      return existsAfter(shiftDocPath(tenantId, shiftId))
        && shiftAfter(tenantId, shiftId).data.status == 'closed'
        && shiftAfter(tenantId, shiftId).data.vaultTransferOnClose is number
        && shiftAfter(tenantId, shiftId).data.vaultTransferOnClose > 0;
    }

    function shiftClosesForVaultInTxn(tenantId, shiftId) {
      return shiftWasOpenForVault(tenantId, shiftId)
        && shiftAfterClosedForVault(tenantId, shiftId)
        && shiftAfter(tenantId, shiftId).data.vaultCloseMovementId == closeVaultMovementId(shiftId);
    }

    function isBalanceOnlySupplierPatch() {
      return request.resource != null
        && resource != null
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['balance', 'balanceReconciledAtMs', 'updatedAt']);
    }

    function isAuditedSupplierBalanceCorrection() {
      return request.resource.data.keys().hasAll([
        'balance', 'balanceCorrectionAtMs', 'balanceCorrectionBy', 'balanceCorrectionReason'
      ]);
    }

    function sensitiveExpenseCreate() {
      return request.resource.data.keys().hasAny([
        'payrollAccrualId', 'employeeAdvanceId', 'advanceRepaymentId', 'isAdvanceRepayment'
      ]);
    }

    function isCashCloseVaultMovementDoc(tenantId, movementId) {
      let shiftId = request.resource.data.shiftId;
      return isTenantCashier(tenantId)
        && request.resource.data.type == 'from_cash_close'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && shiftId is string
        && shiftId.size() > 0
        && movementId == closeVaultMovementId(shiftId)
        && !exists(vaultMovementAfterPath(tenantId, movementId))
        && shiftWasOpenForVault(tenantId, shiftId)
        && existsAfter(shiftDocPath(tenantId, shiftId))
        && shiftAfter(tenantId, shiftId).data.status == 'closed'
        && shiftAfter(tenantId, shiftId).data.vaultTransferOnClose == request.resource.data.amount
        && existsAfter(closeCashDrawerMovementPath(tenantId, shiftId))
        && getAfter(closeCashDrawerMovementPath(tenantId, shiftId)).data.amount
            == request.resource.data.amount
        && request.resource.data.keys().hasOnly([
          'type', 'amount', 'reason', 'shiftId', 'createdBy', 'employeeId', 'createdAt', 'createdAtMs'
        ]);
    }

  /** زيادة الخزنة فقط ضمن معاملة إغلاق شفت مرتبطة (getAfter). */
    function isCashCloseVaultIncrease(tenantId) {
      let shiftId = request.resource.data.lastVaultCloseShiftId;
      return isTenantCashier(tenantId)
        && resource != null
        && request.resource.data.balance is number
        && resource.data.balance is number
        && request.resource.data.balance > resource.data.balance
        && request.resource.data.keys().hasAll([
          'balance', 'updatedAtMs',
          'lastVaultCloseShiftId', 'lastVaultCloseAmount', 'lastVaultCloseMovementId'
        ])
        && request.resource.data.lastVaultCloseAmount
            == request.resource.data.balance - resource.data.balance
        && request.resource.data.lastVaultCloseMovementId == closeVaultMovementId(shiftId)
        && shiftWasOpenForVault(tenantId, shiftId)
        && shiftAfterClosedForVault(tenantId, shiftId)
        && shiftAfter(tenantId, shiftId).data.vaultCloseMovementId == closeVaultMovementId(shiftId)
        && shiftAfter(tenantId, shiftId).data.vaultTransferOnClose
            == request.resource.data.lastVaultCloseAmount
        && existsAfter(vaultMovementAfterPath(tenantId, closeVaultMovementId(shiftId)))
        && getAfter(vaultMovementAfterPath(tenantId, closeVaultMovementId(shiftId))).data.amount
            == request.resource.data.lastVaultCloseAmount
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'balance', 'totalCapitalIn', 'updatedAt', 'updatedAtMs',
              'lastVaultCloseShiftId', 'lastVaultCloseAmount', 'lastVaultCloseMovementId'
            ]);
    }

    function cashierForbiddenOpenShiftPatch() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasAny([
            'status', 'openingBalance', 'shiftPeriod', 'openedAt', 'openedAtMs', 'openedBy',
            'closedAt', 'closedAtMs', 'closedBy', 'vaultTransferOnClose', 'vaultCloseMovementId',
            'actualClosingBalance', 'expectedClosingBalance', 'difference', 'closingNotes'
          ]);
    }

    function isCashShiftOpenCreate() {
      return request.resource.data.status == 'open'
        && request.resource.data.shiftPeriod in [1, 2]
        && request.resource.data.openingBalance is number
        && request.resource.data.openingBalance >= 0;
    }

    function isCashShiftOperationalUpdate(tenantId) {
      return isTenantCashier(tenantId)
        && resource.data.status == 'open'
        && request.resource.data.status == 'open'
        && !cashierForbiddenOpenShiftPatch();
    }

    function isCashShiftCloseUpdate(tenantId, shiftId) {
      let movId = closeVaultMovementId(shiftId);
      return isTenantCashier(tenantId)
        && resource.data.status == 'open'
        && request.resource.data.status == 'closed'
        && request.resource.data.vaultTransferOnClose is number
        && request.resource.data.vaultTransferOnClose >= 0
        && (
          (request.resource.data.vaultTransferOnClose == 0
            && (!('vaultCloseMovementId' in request.resource.data)
                || request.resource.data.vaultCloseMovementId == null))
          || (request.resource.data.vaultTransferOnClose > 0
            && request.resource.data.vaultCloseMovementId == movId
            && existsAfter(vaultMovementAfterPath(tenantId, movId))
            && getAfter(vaultMovementAfterPath(tenantId, movId)).data.type == 'from_cash_close'
            && getAfter(vaultMovementAfterPath(tenantId, movId)).data.amount
                == request.resource.data.vaultTransferOnClose
            && existsAfter(vaultMainPath(tenantId))
            && getAfter(vaultMainPath(tenantId)).data.lastVaultCloseShiftId == shiftId
            && getAfter(vaultMainPath(tenantId)).data.lastVaultCloseAmount
                == request.resource.data.vaultTransferOnClose
            && getAfter(vaultMainPath(tenantId)).data.lastVaultCloseMovementId == movId
            && existsAfter(closeCashDrawerMovementPath(tenantId, shiftId))
            && getAfter(closeCashDrawerMovementPath(tenantId, shiftId)).data.amount
                == request.resource.data.vaultTransferOnClose
            && getAfter(closeCashDrawerMovementPath(tenantId, shiftId)).data.toVault == true)
        )
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['openingBalance', 'shiftPeriod', 'openedAt', 'openedAtMs', 'openedBy']);
    }

    function linkedBusinessDayShifts(tenantId) {
      let s1 = request.resource.data.shift1Id;
      let s2 = request.resource.data.shift2Id;
      return s1 is string && s2 is string && s1.size() > 0 && s2.size() > 0
        && exists(shiftDocPath(tenantId, s1))
        && exists(shiftDocPath(tenantId, s2))
        && get(shiftDocPath(tenantId, s1)).data.status == 'closed'
        && get(shiftDocPath(tenantId, s2)).data.status == 'closed'
        && get(shiftDocPath(tenantId, s1)).data.shiftPeriod == 1
        && get(shiftDocPath(tenantId, s2)).data.shiftPeriod == 2
        && request.resource.data.closedAtMs is number
        && get(shiftDocPath(tenantId, s2)).data.closedAtMs == request.resource.data.closedAtMs;
    }

    function isCashierBusinessDaySummaryCreate(tenantId) {
      return isTenantCashier(tenantId)
        && linkedBusinessDayShifts(tenantId)
        && request.resource.data.businessDayKey is string
        && request.resource.data.keys().hasOnly([
          'businessDayKey', 'closedAtMs', 'shift1Id', 'shift2Id', 'createdAt', 'createdAtMs'
        ]);
    }

    function isCashierBusinessDayArchiveCreate(tenantId) {
      return isTenantCashier(tenantId)
        && linkedBusinessDayShifts(tenantId)
        && request.resource.data.businessDayKey is string
        && request.resource.data.status == 'closed'
        && request.resource.data.shiftIds.size() == 2
        && request.resource.data.keys().hasOnly([
          'businessDayKey', 'closedAtMs', 'shift1Id', 'shift2Id', 'shiftIds', 'status',
          'createdAt', 'updatedAt'
        ]);
    }

    // --- Login index (written by admin when approving cashier) ---
    match /userTenants/{authUid} {
      allow read: if signedIn() && request.auth.uid == authUid;
      allow create: if signedIn() && request.auth.uid == authUid
        && request.resource.data.tenantId == authUid
        && request.resource.data.role == 'admin'
        && legacyUnmigratedOwner(request.resource.data.tenantId);
      allow create: if signedIn()
        && request.auth.uid == authUid
        && request.resource.data.tenantId == authUid
        && request.resource.data.role == 'admin'
        && request.auth.uid == request.resource.data.tenantId
        && exists(/databases/$(database)/documents/tenants/$(request.resource.data.tenantId));
      allow create: if signedIn()
        && request.auth.uid == authUid
        && request.resource.data.tenantId == authUid
        && request.resource.data.role == 'admin'
        && exists(memberDocPath(request.resource.data.tenantId))
        && get(memberDocPath(request.resource.data.tenantId)).data.role == 'admin';
      allow create, update: if signedIn()
        && isTenantAdmin(request.resource.data.tenantId)
        && authUid != request.auth.uid;
      allow delete: if signedIn()
        && isTenantAdmin(resource.data.tenantId)
        && authUid != request.auth.uid;
    }

    match /tenants/{tenantId} {
      allow get: if signedIn();
      allow list: if canReadBusinessData(tenantId);
      allow create: if legacyUnmigratedOwner(tenantId);
      allow update: if isTenantAdmin(tenantId);
      allow delete: if false;

      match /members/{memberUid} {
        allow read: if canReadBusinessData(tenantId)
          || (signedIn() && request.auth.uid == memberUid);
        allow create: if legacyUnmigratedOwner(tenantId) && memberUid == request.auth.uid;
        allow create: if signedIn()
          && memberUid == request.auth.uid
          && request.auth.uid == tenantId
          && request.resource.data.role == 'admin'
          && request.resource.data.active == true
          && exists(/databases/$(database)/documents/tenants/$(tenantId))
          && !exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(memberUid));
        allow create: if isTenantAdmin(tenantId) && memberUid != request.auth.uid;
        allow update: if signedIn() && memberUid == request.auth.uid && false;
        allow update: if isTenantAdmin(tenantId)
          && memberUid != request.auth.uid
          && request.resource.data.role in ['admin', 'cashier']
          && request.resource.data.active is bool;
        allow delete: if isTenantAdmin(tenantId) && memberUid != request.auth.uid;
      }

      match /joinRequests/{requestUid} {
        allow read: if isTenantAdmin(tenantId);
        allow create: if signedIn()
          && request.auth.uid == requestUid
          && request.resource.data.status == 'pending'
          && request.resource.data.keys().hasOnly([
            'email', 'status', 'createdAt', 'createdAtMs'
          ]);
        allow update, delete: if isTenantAdmin(tenantId);
      }
    }

  // --- Business data (unchanged paths: users/{tenantId}/...) ---
    match /users/{tenantId} {
      allow read: if canReadBusinessData(tenantId)
        || (signedIn() && request.auth.uid == tenantId);
      allow create: if legacyUnmigratedOwner(tenantId);
      allow update: if isTenantAdmin(tenantId) || legacyUnmigratedOwner(tenantId);
      allow delete: if false;

      match /suppliers/{supplierId} {
        allow read: if canReadBusinessData(tenantId);
        allow create, delete: if canWriteBusinessData(tenantId);
        allow update: if resource != null
          && canWriteBusinessData(tenantId)
          && !isBalanceOnlySupplierPatch();
        allow update: if resource != null
          && isTenantAdmin(tenantId)
          && isAuditedSupplierBalanceCorrection();
      }

      match /vault/{docId} {
        allow get: if canReadBusinessData(tenantId);
        allow list: if isTenantAdmin(tenantId) || legacyUnmigratedOwner(tenantId);
        allow create, update, delete: if isTenantAdmin(tenantId) || legacyUnmigratedOwner(tenantId);
        allow update: if isCashCloseVaultIncrease(tenantId);
      }

      match /vaultMovements/{movementId} {
        allow read: if canReadBusinessData(tenantId);
        allow create, update, delete: if isTenantAdmin(tenantId) || legacyUnmigratedOwner(tenantId);
        allow create: if isCashCloseVaultMovementDoc(tenantId, movementId);
      }

      match /cashShifts/{shiftId} {
        allow read: if canReadBusinessData(tenantId);
        allow create: if isTenantCashier(tenantId) && isCashShiftOpenCreate();
        allow create, update, delete: if isTenantAdmin(tenantId) || legacyUnmigratedOwner(tenantId);
        allow update: if isCashShiftOperationalUpdate(tenantId);
        allow update: if isCashShiftCloseUpdate(tenantId, shiftId);
        allow delete: if false;
      }

      match /businessDays/{dayId} {
        allow read: if canReadBusinessData(tenantId);
        allow create, update, delete: if isTenantAdmin(tenantId) || legacyUnmigratedOwner(tenantId);
        allow create: if isCashierBusinessDayArchiveCreate(tenantId);
        allow update, delete: if false;
      }

      match /businessDaySummaries/{summaryId} {
        allow read: if canReadBusinessData(tenantId);
        allow create, update, delete: if isTenantAdmin(tenantId) || legacyUnmigratedOwner(tenantId);
        allow create: if isCashierBusinessDaySummaryCreate(tenantId);
        allow update, delete: if false;
      }

      match /{subCollection}/{docId} {
        allow read: if canReadBusinessData(tenantId);

        allow write: if legacyUnmigratedOwner(tenantId);

        allow create, update, delete: if isTenantAdmin(tenantId) && !adminOnlyCollection(subCollection);

        allow create, update, delete: if isTenantCashier(tenantId)
          && !adminOnlyCollection(subCollection)
          && subCollection != 'businessDaySummaries'
          && subCollection != 'businessDays'
          && subCollection != 'cashShifts'
          && subCollection != 'suppliers'
          && !(subCollection == 'expenses' && sensitiveExpenseCreate());
      }
    }
  }
}