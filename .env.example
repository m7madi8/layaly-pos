# ═══════════════════════════════════════════════════════════════
# ربط ليالي كافيه بـ Firebase (Production)
# انسخ إلى .env.local — راجع docs/PRODUCTION.md
# ═══════════════════════════════════════════════════════════════

REACT_APP_DEMO_MODE=false

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# بريد الدخول — يطابق مستخدم Firebase Authentication (كلمة المرور في Firebase فقط)
REACT_APP_ADMIN_EMAIL=admin@layali.cafe

# إلزامي لبناء الإنتاج — لا تستخدم القيم الافتراضية (admin123 / 1221)
REACT_APP_EMPLOYEE_PASSWORD=
REACT_APP_VAULT_PIN=

# اختياري — دوال Firebase (بعد النشر)
# REACT_APP_FUNCTIONS_REGION=europe-west1
# REACT_APP_FUNCTIONS_EMULATOR=true

# ── Staging only (separate Firebase project — never use production project id) ──
# REACT_APP_STAGING_BUILD=true
# REACT_APP_FIREBASE_PROJECT_ID=<your-staging-project-id>

# Phase 2+ — trusted callables (staging only until hardened rules + functions deployed)
# REACT_APP_TRUSTED_ORDERS=true
# REACT_APP_TRUSTED_CASH_SHIFTS=true
# REACT_APP_FUNCTIONS_REGION=europe-west1
# REACT_APP_VERIFY_EMPLOYEE_PIN_ON_SERVER=true
