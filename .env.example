# ═══════════════════════════════════════════════════════════════
# ربط ليالي كافيه بـ Firebase
# ═══════════════════════════════════════════════════════════════
# 1) أنشئ مشروعاً على https://console.firebase.google.com
# 2) فعّل Authentication → Email/Password
# 3) أنشئ Firestore Database (production mode ثم انشر firestore.rules)
# 4) أنشئ Storage (وانشر storage.rules)
# 5) Project settings → Your apps → Web → انسخ firebaseConfig
# 6) انسخ هذا الملف إلى .env.local وعبّئ القيم أدناه
# 7) REACT_APP_DEMO_MODE=false  ثم أعد تشغيل npm start
#
# نشر القواعد (مرة واحدة، يتطلب Firebase CLI):
#   npm i -g firebase-tools
#   firebase login
#   firebase use <PROJECT_ID>
#   firebase deploy --only firestore:rules,storage

REACT_APP_DEMO_MODE=false

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
